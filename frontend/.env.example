# Copy to .env.local and adjust. Files named .env* are gitignored (except this one).

# Production API URL. Must be https:// (production builds refuse plain http).
# Leave unset in development: the app calls /api, which Vite proxies to the backend.
# VITE_API_URL=https://api.example.com

# Where the dev server forwards /api requests. Defaults to http://localhost:8080.
# BACKEND_URL=http://localhost:8080
